{
  "name": "deposim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch server/src/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "tsc -p tsconfig.json",
    "start": "node server/dist/main.js",
    "test": "vitest run",
    "probe": "tsx server/scripts/probe.ts",
    "dev:fake": "tsx server/src/dev-fake.ts",
    "e2e": "playwright test",
    "acceptance": "tsx server/scripts/acceptance.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "@fastify/websocket": "^11.3.4",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.12.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5",
    "lightweight-charts": "^5.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7",
    "vitest": "^3"
  }
}
